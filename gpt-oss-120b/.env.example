# cp .env.example .env 후 필요한 값만 수정
#
# openai/gpt-oss-120b : 117B 파라미터 / 활성 5.1B MoE, MoE 가중치가 MXFP4로 사전 양자화되어
# 배포된다. HF 저장소 루트의 safetensors는 65.3GB(= 약 60.8GiB)로, 이 저장소의 다른 모델과 달리
# **H100 80GB 한 장에 들어간다**. (repo 전체는 195.8GB지만 original/ metal/ 은 다른 런타임용
# 중복본이라 vLLM 경로에서는 받지 않는다 — docs/gpt-oss-120b.md 참고)

HOST_PORT=8500
HF_CACHE_DIR=/data/models/huggingface
HF_TOKEN=
MODEL_NAME=openai/gpt-oss-120b
SERVED_MODEL_NAME=gpt-oss-120b

# 이미지 고정용. 동작 확인 전까지는 latest, 확인 후 실제 버전으로 고정 권장.
VLLM_IMAGE=vllm/vllm-openai:latest

# ---------------------------------------------------------------------------
# 실행 프로파일 — 아래 셋 중 하나를 골라 GPU_DEVICE_IDS / TENSOR_PARALLEL_SIZE 를 맞춘다.
# GPU_DEVICE_IDS의 장수 == TENSOR_PARALLEL_SIZE 여야 한다.
# 반드시 먼저 실행:
#   nvidia-smi --query-gpu=index,memory.total,memory.used,memory.free --format=csv
# ---------------------------------------------------------------------------

# [프로파일 A] 단일 GPU (TP=1) — 기본값. GPU 7장을 다른 사용자/모델에 남겨둔다.
#   가중치 약 60.8GiB가 79.6GiB 중 76%를 점유 → KV 캐시 여유는 약 11~12GiB.
#   131072 컨텍스트 1개 시퀀스가 KV 약 4.5GiB이므로 동시 처리 2~3 시퀀스 수준.
GPU_DEVICE_IDS=0
TENSOR_PARALLEL_SIZE=1

# [프로파일 B] 2 GPU (TP=2) — 동시성/컨텍스트 여유 확보. 6장을 남긴다.
#   GPU당 가중치 약 30.4GiB → KV 여유가 GPU당 40GiB 이상으로 크게 늘어난다.
#   vLLM 레시피 주의사항: TP=2에서는 gpu-memory-utilization을 0.95 미만으로 둘 것.
# GPU_DEVICE_IDS=0,1
# TENSOR_PARALLEL_SIZE=2
# GPU_MEMORY_UTILIZATION=0.90

# [프로파일 C] 8 GPU (TP=8) — 처리량 최대. 단, 이 서버에서 다른 모델과 동시 운영 불가.
#   docker-compose.yml의 --enable-expert-parallel 주석 해제를 함께 검토할 것
#   (2880 / 8 = 360 은 MXFP4 블록 32로 나누어떨어지지 않음 — README.md 참고).
# GPU_DEVICE_IDS=0,1,2,3,4,5,6,7
# TENSOR_PARALLEL_SIZE=8
# MAX_NUM_BATCHED_TOKENS=10240
# MAX_NUM_SEQS=128
# GPU_MEMORY_UTILIZATION=0.85

# ---------------------------------------------------------------------------

# 모델 공식 컨텍스트(config.json max_position_embeddings = 131072).
# TP=1에서 기동이 KV 캐시 부족으로 실패하면 여기부터 낮춘다 (예: 65536 → 32768).
MAX_MODEL_LEN=131072

# vLLM 공식 레시피에 명시된 "H100 TP1 OOM" 완화책 조합.
# TP를 올리면 두 값을 올려도 된다(프로파일 B/C 주석 참고).
GPU_MEMORY_UTILIZATION=0.95
MAX_NUM_BATCHED_TOKENS=1024
MAX_NUM_SEQS=8

# opencode 등 tool-calling 클라이언트 연결에 필요.
# gpt-oss는 harmony 포맷이라 파서 이름이 모델명과 다르다 (vLLM 0.25.1 이미지에서 직접 확인).
TOOL_CALL_PARSER=openai
REASONING_PARSER=openai_gptoss
