# cp .env.example .env 후 필요한 값만 수정
HOST_PORT=8000
GPU_DEVICE_IDS=0,1,2,3,4,5,6,7
HF_CACHE_DIR=/data/models/huggingface
HF_TOKEN=
MODEL_NAME=Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8
SERVED_MODEL_NAME=qwen3-coder-480b

# 주의: TENSOR_PARALLEL_SIZE=8은 FP8 블록 양자화(block_n=128)와 MoE gate/up
# projection 샤드 크기가 나누어떨어지지 않아 실패한다 (README.md 3단계 참고).
# 8개 GPU를 모두 쓰려면 TENSOR_PARALLEL_SIZE x PIPELINE_PARALLEL_SIZE = 8 유지.
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=2
MAX_MODEL_LEN=131072

# opencode 등 tool-calling 클라이언트 연결에 필요
TOOL_CALL_PARSER=qwen3_coder
